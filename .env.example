NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=https://lava.avenuemedia.io
READ_ONLY_MODE=true
ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://claude.ai,https://claude.com
REQUIRE_MCP_AUTH=true
ALLOW_PUBLIC_MCP_DISCOVERY=true
# Required when REQUIRE_MCP_AUTH=true, and ALWAYS required when NODE_ENV=production.
# The server refuses to start without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_BEARER_TOKEN=REPLACE_WITH_RANDOM_BEARER_TOKEN
# Optional: set a password to enable OAuth so Claude.ai's connector can authenticate
# (Claude cannot send a static bearer token; it uses OAuth). When set, Claude users
# see a login page at /authorize and enter this password. Leave empty to keep OAuth off.
# The static MCP_BEARER_TOKEN keeps working in parallel (ChatGPT / curl / WP plugin).
MCP_OAUTH_PASSWORD=
LOG_LEVEL=info
# Master key (>=32 chars) used to AES-256-GCM encrypt project credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SECRETS_MASTER_KEY=REPLACE_WITH_RANDOM_BASE64_AT_LEAST_32_CHARS
# Anthropic API key for content generation (Claude Sonnet 4.6).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
DATABASE_URL=postgresql://postgres.bfidzlbmkpegnndijosw:REPLACE_WITH_SUPABASE_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.bfidzlbmkpegnndijosw:REPLACE_WITH_SUPABASE_DB_PASSWORD@aws-0-eu-west