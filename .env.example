NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=https://lava.avenuemedia.io
READ_ONLY_MODE=true
ALLOWED_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://claude.ai,https://claude.com
REQUIRE_MCP_AUTH=true
ALLOW_PUBLIC_MCP_DISCOVERY=true
MCP_BEARER_TOKEN=
LOG_LEVEL=info
# Master key (>=32 chars) used to AES-256-GCM encrypt project credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SECRETS_MASTER_KEY=REPLACE_WITH_RANDOM_BASE64_AT_LEAST_32_CHARS
DATABASE_URL=pos