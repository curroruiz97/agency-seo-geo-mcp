generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ClientStatus {
  active
  paused
  archived
}

enum ProjectStatus {
  active
  paused
  archived
}

enum PermissionLevel {
  read_only
  proposal_only
  approved_writes
}

enum CredentialType {
  wordpress_application_password
  wordpress_oauth
  rankmath_bridge_token
  seranking_token
}

enum OpportunityStatus {
  open
  proposed
  in_progress
  closed
  dismissed
}

enum ChangeRequestStatus {
  proposed
  approved
  applied
  verified
  rejected
  failed
  rolled_back
}

enum RiskLevel {
  low
  medium
  high
  critical
}

model Client {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  companyName  String?   @map("company_name")
  contactEmail String?   @map("contact_email")
  status       ClientStatus @default(active)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  projects Project[]
  reports  Report[]

  @@map("clients")
}

model Project {
  id                String          @id @default(uuid()) @db.Uuid
  clientId          String          @map("client_id") @db.Uuid
  name              String
  domain            String
  wordpressUrl      String          @map("wordpress_url")
  wordpressStagingUrl String?       @map("wordpress_staging_url")
  serankingProjectId String?        @map("seranking_project_id")
  language          String          @default("es")
  targetCountry     String?         @map("target_country")
  targetCity        String?         @map("target_city")
  sector            String?
  businessType      String?         @map("business_type")
  seoPlugin         String          @default("rank_math_pro") @map("seo_plugin")
  builder           String          @default("elementor")
  permissionLevel   PermissionLevel @default(read_only) @map("permission_level")
  status            ProjectStatus   @default(active)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  client           Client              @relation(fields: [clientId], references: [id])
  capabilities     ProjectCapability?
  credentials      ProjectCredential[]
  opportunities    Opportunity[]
  changeRequests   ChangeRequest[]
  actionLogs       ActionLog[]
  reports          Report[]
  blogConfig       BlogConfig?
  blogKeywordsUsed BlogKeywordUsed[]

  @@unique([domain])
  @@index([clientId])
  @@index([status])
  @@map("projects")
}

model ProjectCapability {
  id                                String   @id @default(uuid()) @db.Uuid
  projectId                         String   @unique @map("project_id") @db.Uuid
  canReadWordpress                  Boolean  @default(true) @map("can_read_wordpress")
  canCreateDrafts                   Boolean  @default(false) @map("can_create_drafts")
  canUpdateRankmath                 Boolean  @default(false) @map("can_update_rankmath")
  canUpdateElementor                Boolean  @default(false) @map("can_update_elementor")
  canPublish                        Boolean  @default(false) @map("can_publish")
  canChangeSlugs                    Boolean  @default(false) @map("can_change_slugs")
  canChangeCanonical                Boolean  @default(false) @map("can_change_canonical")
  canChangeRobots                   Boolean  @default(false) @map("can_change_robots")
  requiresHumanApproval             Boolean  @default(true) @map("requires_human_approval")
  requiresDoubleApprovalForHighRisk Boolean  @default(true) @map("requires_double_approval_for_high_risk")
  createdAt                         DateTime @default(now()) @map("created_at")
  updatedAt                         DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_capabilities")
}

model ProjectCredential {
  id               String         @id @default(uuid()) @db.Uuid
  projectId        String         @map("project_id") @db.Uuid
  credentialType   CredentialType @map("credential_type")
  label            String?
  encryptedPayload String         @map("encrypted_payload")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  lastUsedAt       DateTime?      @map("last_used_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([credentialType])
  @@map("project_credentials")
}

model Opportunity {
  id                   String            @id @default(uuid()) @db.Uuid
  projectId            String            @map("project_id") @db.Uuid
  source               String?
  url                  String?
  keyword              String?
  opportunityType      String            @map("opportunity_type")
  currentPosition      Int?              @map("current_position")
  previousPosition     Int?              @map("previous_position")
  searchVolume         Int?              @map("search_volume")
  intent               String?
  impactScore          Decimal?          @map("impact_score")
  easeScore            Decimal?          @map("ease_score")
  commercialValueScore Decimal?          @map("commercial_value_score")
  urgencyScore         Decimal?          @map("urgency_score")
  confidenceScore      Decimal?          @map("confidence_score")
  riskScore            Decimal?          @map("risk_score")
  priorityScore        Decimal?          @map("priority_score")
  summary              String
  recommendedAction    String?           @map("recommended_action")
  status               OpportunityStatus @default(open)
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  changeRequests ChangeRequest[]

  @@index([projectId])
  @@index([status])
  @@index([priorityScore])
  @@map("opportunities")
}

model ChangeRequest {
  id               String              @id @default(uuid()) @db.Uuid
  projectId        String              @map("project_id") @db.Uuid
  opportunityId    String?             @map("opportunity_id") @db.Uuid
  url              String?
  targetEntityType String              @map("target_entity_type")
  targetEntityId   String?             @map("target_entity_id")
  changeType       String              @map("change_type")
  riskLevel        RiskLevel           @map("risk_level")
  status           ChangeRequestStatus @default(proposed)
  beforePayload    Json?               @map("before_payload")
  afterPayload     Json?               @map("after_payload")
  diffPayload      Json?               @map("diff_payload")
  reason           String?
  expectedImpact   String?             @map("expected_impact")
  requiresApproval Boolean             @default(true) @map("requires_approval")
  approvedBy       String?             @map("approved_by")
  approvedAt       DateTime?           @map("approved_at")
  appliedAt        DateTime?           @map("applied_at")
  verifiedAt       DateTime?           @map("verified_at")
  rollbackPayload  Json?               @map("rollback_payload")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  actionLogs  ActionLog[]

  @@index([projectId])
  @@index([opportunityId])
  @@index([status])
  @@map("change_requests")
}

model ActionLog {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String?  @map("project_id") @db.Uuid
  changeRequestId String?  @map("change_request_id") @db.Uuid
  toolName        String?  @map("tool_name")
  actionType      String   @map("action_type")
  status          String
  inputPayload    Json?    @map("input_payload")
  outputPayload   Json?    @map("output_payload")
  errorMessage    String?  @map("error_message")
  createdBy       String?  @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  changeRequest ChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([changeRequestId])
  @@index([toolName])
  @@index([createdAt])
  @@map("action_logs")
}

model Report {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String?  @map("project_id") @db.Uuid
  clientId        String?  @map("client_id") @db.Uuid
  reportType      String   @map("report_type")
  periodStart     DateTime @map("period_start") @db.Date
  periodEnd       DateTime @map("period_end") @db.Date
  contentMarkdown String   @map("content_markdown")
  metricsPayload  Json?    @map("metrics_payload")
  createdAt       DateTime @default(now()) @map("created_at")

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([clientId])
  @@index([reportType])
  @@map("reports")
}

// ============================================================================
// EXTRACT layer: data pulled from SE Ranking (idempotent, snapshot history)
// ============================================================================

enum ExtractionStatus {
  pending
  running
  completed
  failed
}

enum ExtractionSource {
  seranking
  wordpress
  rankmath
  gsc
  ga
  manual
}

model ExtractionRun {
  id          String           @id @default(uuid()) @db.Uuid
  projectId   String           @map("project_id") @db.Uuid
  source      ExtractionSource
  status      ExtractionStatus @default(pending)
  startedAt   DateTime         @default(now()) @map("started_at")
  finishedAt  DateTime?        @map("finished_at")
  stats       Json?
  errorMessage String?         @map("error_message")

  @@index([projectId])
  @@index([source])
  @@index([status])
  @@map("extraction_runs")
}

model Keyword {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  keyword         String
  searchVolume    Int?     @map("search_volume")
  difficulty      Int?
  intent          String?
  cpc             Decimal?
  language        String?
  country         String?
  serankingId     String?  @map("seranking_id")
  groupName       String?  @map("group_name")
  firstSeenAt     DateTime @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime @default(now()) @map("last_seen_at")

  snapshots KeywordSnapshot[]

  @@unique([projectId, keyword])
  @@index([projectId])
  @@index([serankingId])
  @@map("keywords")
}

model KeywordSnapshot {
  id                  String   @id @default(uuid()) @db.Uuid
  keywordId           String   @map("keyword_id") @db.Uuid
  capturedAt          DateTime @default(now()) @map("captured_at")
  position            Int?
  previousPosition    Int?     @map("previous_position")
  url                 String?
  device              String?
  location            String?
  changeVsPrevious    Int?     @map("change_vs_previous")
  inTop3              Boolean  @default(false) @map("in_top_3")
  inTop10             Boolean  @default(false) @map("in_top_10")
  inOpportunityWindow Boolean  @default(false) @map("in_opportunity_window")

  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([keywordId])
  @@index([capturedAt])
  @@index([inOpportunityWindow])
  @@map("keyword_snapshots")
}

enum AuditSeverity {
  info
  notice
  warning
  error
  critical
}

model AuditFinding {
  id            String        @id @default(uuid()) @db.Uuid
  projectId     String        @map("project_id") @db.Uuid
  category      String
  ruleCode      String        @map("rule_code")
  severity      AuditSeverity
  url           String?
  message       String
  details       Json?
  firstSeenAt   DateTime      @default(now()) @map("first_seen_at")
  lastSeenAt    DateTime      @default(now()) @map("last_seen_at")
  resolvedAt    DateTime?     @map("resolved_at")

  @@unique([projectId, ruleCode, url])
  @@index([projectId])
  @@index([severity])
  @@map("audit_findings")
}

model Competitor {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  domain          String
  visibilityScore Decimal? @map("visibility_score")
  sharedKeywords  Int?     @map("shared_keywords")
  exclusiveKeywords Int?   @map("exclusive_keywords")
  lastSeenAt      DateTime @default(now()) @map("last_seen_at")

  contentGaps ContentGap[]

  @@unique([projectId, domain])
  @@index([projectId])
  @@map("competitors")
}

model ContentGap {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  competitorId String?  @map("competitor_id") @db.Uuid
  keyword      String
  searchVolume Int?     @map("search_volume")
  difficulty   Int?
  competitorPosition Int? @map("competitor_position")
  ourPosition  Int?     @map("our_position")
  gapType      String   @map("gap_type")
  detectedAt   DateTime @default(now()) @map("detected_at")

  competitor Competitor? @relation(fields: [competitorId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([competitorId])
  @@map("content_gaps")
}

enum ContentDraftStatus {
  proposed
  approved
  generating
  ready
  published
  rejected
}

model ContentDraft {
  id              String             @id @default(uuid()) @db.Uuid
  projectId       String             @map("project_id") @db.Uuid
  changeRequestId String?            @unique @map("change_request_id") @db.Uuid
  topic           String
  primaryKeyword  String             @map("primary_keyword")
  secondaryKeywords String[]         @map("secondary_keywords")
  intent          String?
  targetUrl       String?            @map("target_url")
  outline         Json?
  contentHtml     String?            @map("content_html")
  metaTitle       String?            @map("meta_title")
  metaDescription String?            @map("meta_description")
  faqSchema       Json?              @map("faq_schema")
  internalLinks   Json?              @map("internal_links")
  status          ContentDraftStatus @default(proposed)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  publishedAt     DateTime?          @map("published_at")
  wpPostId        String?            @map("wp_post_id")

  @@index([projectId])
  @@index([status])
  @@map("content_drafts")
}

// ============================================================================
// BLOG AUTOMATION layer: per-site blog config + used-keyword registry.
// ============================================================================

model BlogConfig {
  id                String   @id @default(uuid()) @db.Uuid
  projectId         String   @unique @map("project_id") @db.Uuid
  configured        Boolean  @default(true)
  sector            String?
  seedKeywords      String[] @map("seed_keywords")
  language          String   @default("es-ES")
  city              String?
  defaultCategoryId Int?     @map("default_category_id")
  defaultAuthorId   Int?     @map("default_author_id")
  renderMode        String   @default("theme-builder-single") @map("render_mode")
  templateId        Int?     @map("template_id")
  templateType      String?  @map("template_type")
  templateName      String?  @map("template_name")
  minImages         Int      @default(4) @map("min_images")
  imageSource       String?  @map("image_source")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("blog_config")
}

model BlogKeywordUsed {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  keyword   String
  secondary String[]
  postId    String?  @map("post_id")
  title     String?
  slug      String?
  status    String   @default("draft")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, keyword])
  @@index([projectId])
  @@map("blog_keywords_used")
}
